{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial proposal (a full replacement sequence for one stage)",
  "type": "object",
  "required": ["id", "stage", "status", "sequence"],
  "properties": {
    "id": {"type": "string"},
    "stage": {"type": "string"},
    "status": {"enum": ["proposed", "applied", "withdrawn"]},
    "max_selections": {"type": "integer"},
    "retire": {"type": "array", "items": {"type": "object", "required": ["selection", "reason"]}},
    "new_works": {"type": "array"},
    "sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n"],
        "oneOf": [{"required": ["existing"]}, {"required": ["new"]}]
      }
    }
  }
}
