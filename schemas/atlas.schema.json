{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas root",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "collections"],
  "properties": {
    "title": {"type": "string"},
    "method": {"type": "string"},
    "collections": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "uniqueItems": true}
  }
}
